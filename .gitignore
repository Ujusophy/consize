.DS_Store

# Local env / secrets
.env
.env.*
deploy/dev/.env
deploy/prod/env.sh
!.env.example
!deploy/dev/.env.example
!deploy/prod/env.sh.example

# Build outputs and caches
.gocache/
.consize/
bin/
dist/
/consize
*.test
engine/bin/
engine/collector
engine/.gocache/
ui/node_modules/
ui/.next/
ui/out/
ui/build/
ui/coverage/
ui/tsconfig.tsbuildinfo

# Generated artifacts
tmp/
output/
tests/e2e-live/out/

# Logs
*.log
*.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# MkDocs build output — deploy-docs.yml builds this fresh via `mkdocs build`
# on every push to main and deploys it to GitHub Pages. Committing it here
# too just duplicates it and lets it drift out of sync with docs/ (it
# already had at least one stale page from a since-renamed source file).
site/
